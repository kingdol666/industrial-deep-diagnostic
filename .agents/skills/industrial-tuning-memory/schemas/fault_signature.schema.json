{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fault_signature.schema.json",
  "title": "Fault signature (v1.0) — anomalous parameter set + regime + direction, for playbook retrieval",
  "type": "object",
  "required": ["anomalous_params"],
  "properties": {
    "signature_version": { "const": "1.0" },
    "source_ref": { "type": ["string", "null"], "description": "alert_id / anomaly_report path" },
    "anomalous_params": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["parameter", "direction"],
        "properties": {
          "parameter": { "type": "string" },
          "direction": { "enum": ["high", "low", "unknown"] },
          "severity": { "type": ["number", "null"], "description": "z_score or normalized deviation" }
        }
      }
    },
    "regime": {
      "type": ["object", "null"],
      "properties": {
        "product": { "type": ["string", "null"] },
        "machine": { "type": ["string", "null"] },
        "regime_label": { "type": ["string", "null"] }
      }
    },
    "degraded_metric": { "type": ["string", "null"] }
  }
}
