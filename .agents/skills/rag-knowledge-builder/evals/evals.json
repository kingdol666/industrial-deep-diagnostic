{
  "skill_name": "rag-knowledge-builder",
  "schema_version": "2.0",
  "description": "v4.0 ontology-first evaluation suite. Tests domain identification, ontology construction quality (definition precision, hierarchy completeness, constraint discovery), cross-domain rejection, and NL spec quality.",
  "evals": [
    {
      "id": 1,
      "name": "ontology_construction_industrial",
      "prompt": "检索 CNC 主轴轴承退化的相关知识并构建领域本体模型",
      "expected_output": "ontology_draft.json 包含精确的概念定义、因果链、约束规则和术语映射；NL Spec 完整",
      "files": [],
      "metadata": {
        "domain_type": "cnc_machining",
        "retrieval_mode": "local_only",
        "expected_min_relationships": 5,
        "expected_min_constraints": 3,
        "expected_min_match_rate": 0.6,
        "checks": ["concepts have a definition (not a restatement of the name)", "have broader_concept (hierarchy)", "have constraints", "have terminology mapping"]
      },
      "assertions": [
        {"name": "has_relationships", "jsonpath": "$.relationships.length()", "expected_type": "numeric_gte", "expected_values": [5], "weight": "critical", "description": "At least 5 relationships"},
        {"name": "has_constraints", "jsonpath": "$.constraints.length()", "expected_type": "numeric_gte", "expected_values": [3], "weight": "critical", "description": "At least 3 constraints"},
        {"name": "identifies_confounders", "jsonpath": "$.confounders.length()", "expected_type": "numeric_gte", "expected_values": [2], "weight": "high", "description": "At least 2 confounders"},
        {"name": "match_rate_sufficient", "jsonpath": "$.rag_construction_metadata.match_rate", "expected_type": "numeric_gte", "expected_values": [0.6], "weight": "high", "description": "Match rate >= 0.6"},
        {"name": "scene_has_domain_type", "jsonpath": "$.scene.domain_type", "expected_type": "exists", "expected_values": ["present"], "weight": "medium", "description": "domain_type is present"},
        {"name": "concepts_have_definitions", "jsonpath": "$.concepts.target_concepts[0].definition", "expected_type": "exists", "expected_values": ["present"], "weight": "critical", "description": "Target concepts have a definition"},
        {"name": "concepts_have_hierarchy", "jsonpath": "$.concepts.target_concepts[0].broader_concept", "expected_type": "exists", "expected_values": ["present"], "weight": "high", "description": "Concepts have broader_concept"},
        {"name": "concepts_have_terminology", "jsonpath": "$.concepts.target_concepts[0].terminology", "expected_type": "exists", "expected_values": ["present"], "weight": "medium", "description": "Concepts have terminology mapping"}
      ]
    },
    {
      "id": 2,
      "name": "unknown_domain_graceful_fallback",
      "prompt": "检索一个数据库中没有的新兴领域知识并尝试构建本体",
      "expected_output": "即使没有精确匹配，也不崩溃。报告知识缺口和低匹配率。",
      "files": [],
      "metadata": {
        "domain_type": "unknown_novel",
        "retrieval_mode": "local_only",
        "expected_min_relationships": 0,
        "checks": ["graceful fallback", "knowledge gaps reported", "match_rate reflects reality"]
      },
      "assertions": [
        {"name": "no_crash_on_unknown", "jsonpath": "$.relationships", "expected_type": "exists", "expected_values": ["present"], "weight": "critical", "description": "Does not crash"},
        {"name": "metadata_present", "jsonpath": "$.rag_construction_metadata", "expected_type": "exists", "expected_values": ["present"], "weight": "medium", "description": "Metadata is present"},
        {"name": "low_match_rate_reported", "jsonpath": "$.rag_construction_metadata.match_rate", "expected_type": "numeric_lt", "expected_values": [0.5], "weight": "high", "description": "Match rate <0.5 (reflects insufficient knowledge)"}
      ]
    },
    {
      "id": 3,
      "name": "web_search_integration",
      "prompt": "通过 web 搜索获取外部知识并用于本体构建",
      "expected_output": "web 搜索返回结果并可以与本地结果合并",
      "files": [],
      "metadata": {
        "domain_type": "generic",
        "retrieval_mode": "web_only",
        "expected_min_results": 1,
        "checks": ["web results normalized to chunk format", "source credibility scored"]
      },
      "assertions": [
        {"name": "web_returns_results", "jsonpath": "$.total_chunks_retrieved", "expected_type": "numeric_gte", "expected_values": [1], "weight": "critical", "description": "Web search returns at least 1 result"},
        {"name": "source_marked_web", "jsonpath": "$.chunks[0].source.type", "expected_type": "contains_any", "expected_values": ["web_authoritative", "web_general"], "weight": "high", "description": "Results are tagged as a web source"}
      ]
    },
    {
      "id": 4,
      "name": "quality_rejects_generic_domain",
      "prompt": "验证质量验证 agent 能检测到 domain_type 为 generic 的 ontology",
      "expected_output": "quality verification 应标识 domain_type 为 generic 的 ontology 为 FAIL",
      "files": [],
      "metadata": {
        "domain_type": "generic",
        "expected_verdict": "FAIL",
        "checks": ["schema compliance rejects generic domain_type", "definition quality rejects tautologies"]
      },
      "assertions": [
        {"name": "rejects_generic_type", "jsonpath": "$.checks.schema_compliance.passed", "expected_type": "equals", "expected_values": [false], "weight": "critical", "description": "domain_type generic should be rejected"},
        {"name": "has_eight_checks", "jsonpath": "$.checks", "expected_type": "exists", "expected_values": ["present"], "weight": "high", "description": "All 8 checks are executed"},
        {"name": "produces_fail_verdict", "jsonpath": "$.verdict", "expected_type": "equals", "expected_values": ["FAIL"], "weight": "critical", "description": "Final verdict is FAIL"}
      ]
    },
    {
      "id": 5,
      "name": "nl_spec_quality",
      "prompt": "验证自然语言规范的质量 — 必须是完整的人类可读文档",
      "expected_output": "NL Spec 包含所有 9 个章节，概念定义是完整陈述句",
      "files": [],
      "metadata": {
        "domain_type": "any",
        "checks": ["all 9 sections present", "definitions are full sentences", "no JSON leakage"]
      },
      "assertions": [
        {"name": "nl_spec_exists", "jsonpath": "$.nl_spec_content", "expected_type": "exists", "expected_values": ["present"], "weight": "critical", "description": "The NL Spec file exists"},
        {"name": "has_domain_overview", "jsonpath": "$.nl_spec_sections.domain_overview", "expected_type": "exists", "expected_values": ["present"], "weight": "high", "description": "Contains the domain overview"},
        {"name": "has_concept_dictionary", "jsonpath": "$.nl_spec_sections.concept_dictionary", "expected_type": "exists", "expected_values": ["present"], "weight": "high", "description": "Contains the concept dictionary"},
        {"name": "has_relationship_graph", "jsonpath": "$.nl_spec_sections.relationship_graph", "expected_type": "exists", "expected_values": ["present"], "weight": "high", "description": "Contains the relationship graph"}
      ]
    }
  ]
}
