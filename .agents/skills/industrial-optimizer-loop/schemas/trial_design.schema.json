{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trial_design.schema.json",
  "title": "Optimizer round trial design (v1.0) — machine-executable setpoint recommendations",
  "type": "object",
  "required": ["design_version", "campaign_id", "round_id", "phase", "method", "trials", "provenance"],
  "properties": {
    "design_version": { "const": "1.0" },
    "campaign_id": { "type": "string" },
    "round_id": { "type": "string", "pattern": "^R[0-9]{3}$" },
    "phase": { "enum": ["explore", "exploit", "confirm"] },
    "method": { "enum": ["window_seed", "lhs_fill", "rsm_augment", "gp_ei", "poly_refine", "confirm_replicates", "screen_first"] },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trial_id", "setpoints", "extrapolation", "safety_checked"],
        "properties": {
          "trial_id": { "type": "string", "pattern": "^R[0-9]{3}-T[0-9]{2}$" },
          "setpoints": { "type": "object", "description": "factor name -> numeric value or categorical level string" },
          "replicates": { "type": ["integer", "null"], "minimum": 1 },
          "expected": {
            "type": ["object", "null"],
            "description": "metric -> {mean, ci95}",
            "additionalProperties": { "type": "object", "properties": { "mean": { "type": "number" }, "ci95": { "type": "array", "items": { "type": "number" } } } }
          },
          "predicted_D": { "type": ["number", "null"] },
          "ei": { "type": ["number", "null"] },
          "ucb": { "type": ["number", "null"] },
          "selection_reason": { "type": ["string", "null"], "description": "deterministic rationale; agent must not rewrite numbers" },
          "extrapolation": { "type": "boolean", "description": "O-G3: true when outside data support (coded distance > 0.8) or at domain boundary" },
          "distance_to_incumbent_coded": { "type": ["number", "null"] },
          "safety_checked": { "type": "boolean" }
        }
      }
    },
    "model_summary": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": ["string", "null"] },
        "log_ml": { "type": ["number", "null"] },
        "lengthscales": { "type": ["object", "null"] },
        "sigma_noise": { "type": ["number", "null"] },
        "fallback_active": { "type": ["boolean", "null"] }
      }
    },
    "gating": {
      "type": ["object", "null"],
      "properties": {
        "domain_ok": { "type": ["boolean", "null"] },
        "safety_ok": { "type": ["boolean", "null"] },
        "duplication_ratio": { "type": ["number", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["input_sha256", "script_version", "authored_by"],
      "properties": {
        "input_sha256": { "type": ["string", "null"] },
        "script_version": { "type": "string" },
        "seed": { "type": ["integer", "null"] },
        "authored_by": { "enum": ["script", "agent"] }
      }
    }
  }
}
