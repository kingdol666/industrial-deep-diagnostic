{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOE analysis context (user input / auto-inferred)",
  "type": "object",
  "required": ["data_path"],
  "properties": {
    "data_path": { "type": "string" },
    "mode_override": { "enum": [null, "designed", "observational"] },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["col"],
        "properties": {
          "col": { "type": "string" },
          "goal": { "enum": ["maximize", "minimize", "target", null] },
          "lsl": { "type": ["number", "null"] },
          "usl": { "type": ["number", "null"] },
          "target": { "type": ["number", "null"] },
          "weight": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["col"],
        "properties": {
          "col": { "type": "string" },
          "type": { "enum": ["numeric", "categorical", null] }
        }
      }
    },
    "blocks": { "type": "array", "items": { "type": "string" } },
    "covariates": { "type": "array", "items": { "type": "string" } },
    "index_cols": { "type": "array", "items": { "type": "string" } },
    "time_col": { "type": ["string", "null"] },
    "group_col": { "type": ["string", "null"] },
    "run_order_col": { "type": ["string", "null"] },
    "max_lag": { "type": ["integer", "null"], "minimum": 1 },
    "alpha": { "type": ["number", "null"], "minimum": 0.001, "maximum": 0.2 },
    "effect_size_threshold": { "type": ["number", "null"], "minimum": 0 },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factor"],
        "properties": {
          "factor": { "type": "string" },
          "min": { "type": ["number", "null"] },
          "max": { "type": ["number", "null"] }
        }
      }
    },
    "inference": {
      "type": "object",
      "properties": {
        "assigned_by": { "enum": ["user", "auto"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
