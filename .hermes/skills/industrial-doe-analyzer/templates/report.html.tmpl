BUILDERS.forest = function (el, d) {
  var rows = d.rows;
  var L = 230, Rm = 120, T = 14, rowH = 44;
  var W = L + 460 + Rm + 60, H = T + rows.length * rowH + 30;
  var svg = chartSvg(el, W, H);
  rows.forEach(function (r, i) {
    var y = T + rowH * i + rowH / 2;
    var omin = r.obsmin !== null ? r.obsmin : (r.lo - (r.hi - r.lo) * 0.2);
    var omax = r.obsmax !== null ? r.obsmax : (r.hi + (r.hi - r.lo) * 0.2);
    var pl = L, pr = L + 460;
    function xs(v) { return lin(v, omin, omax, pl, pr); }
    S("rect", { x: pl, y: y - 13, width: pr - pl, height: 26, fill: "#efeeea" }, svg);
    S("line", { x1: pl, y1: y, x2: pr, y2: y, stroke: C.grid }, svg);
    S("text", { x: L - 8, y: y - 3, "text-anchor": "end", "font-size": 10.5, fill: C.ink, "font-weight": 600 },
      svg, String(r.id));
    S("text", { x: L - 8, y: y + 12, "text-anchor": "end", "font-size": 9.5, fill: C.t3 }, svg,
      r.factor + " \u2190 " + r.response + (r.chosen_conflict ? " \u2713" : ""));
    var col = r.confirm ? C.warm : C.green;
    var confCN = ({ high: "置信：高", medium: "置信：中", low: "置信：低" })[r.confidence] || r.confidence;
    var x0 = xs(r.lo), x1 = xs(r.hi);
    var band = S("rect", { x: x0, y: y - 11, width: Math.max(x1 - x0, 2), height: 22, rx: 3,
                           fill: col, opacity: r.loser ? 0.25 : 0.8 }, svg);
    var tipTxt = r.id + " " + r.factor + "\nwindow: [" + fmt(r.lo) + ", " + fmt(r.hi) + "]" +
      "\nobserved: [" + fmt(r.obsmin) + ", " + fmt(r.obsmax) + "]" +
      "\ndelta: " + fmt(r.delta) + " " + (r.unit || "") + "\n" + confCN +
      "\nconfirmation needed: " + (r.confirm ? "yes" : "no");
    if (r.loser) tipTxt += "\nconflict loser (reference only)";
    band.setAttribute("data-tip", tipTxt);
    if (r.loser) {
      S("text", { x: (x0 + x1) / 2, y: y + 3, "text-anchor": "middle", "font-size": 9, fill: "#fff" }, svg,
        "\u843D\u9009");
    }
    if (r.ci && r.ci[0] !== null && r.ci[1] !== null) {
      var c0 = xs(Math.max(r.ci[0], omin - (omax - omin) * 0.1));
      var c1 = xs(Math.min(r.ci[1], omax + (omax - omin) * 0.1));
      var g = S("g", { "class": "ci-el" }, svg);
      S("line", { x1: c0, y1: y, x2: c1, y2: y, stroke: C.ink, "stroke-width": 1.4 }, g);
      S("line", { x1: c0, y1: y - 5, x2: c0, y2: y + 5, stroke: C.ink, "stroke-width": 1.4 }, g);
      S("line", { x1: c1, y1: y - 5, x2: c1, y2: y + 5, stroke: C.ink, "stroke-width": 1.4 }, g);
    }
    if (r.baseline !== null && r.baseline !== undefined) {
      var bx = xs(r.baseline);
      var dm = S("rect", { x: bx - 6, y: y - 6, width: 12, height: 12, fill: C.ink,
                           stroke: "#fff", "stroke-width": 1.5,
                           transform: "rotate(45 " + bx + " " + y + ")" }, svg);
      dm.setAttribute("data-tip", "current baseline: " + fmt(r.baseline));
    }
    S("text", { x: pr + 10, y: y - 3, "font-size": 11, fill: C.t3, "class": "mono-lbl" }, svg,
      "[" + fmt(r.lo) + ", " + fmt(r.hi) + "]");
    S("text", { x: pr + 10, y: y + 13, "font-size": 11,
                fill: r.confirm ? C.warm : C.green }, svg,
      r.confirm ? "\u9700\u786E\u8BA4 \u00B7 " + confCN : confCN);
  });
};

/* ---------------- mount ---------------- */
var mounted = 0;
document.querySelectorAll(".chart-body[data-chart]").forEach(function (body) {
  var kind = body.getAttribute("data-chart");
  var key = body.getAttribute("data-key");
  var data = (PAYLOAD.charts || {})[key];
  if (!data || !BUILDERS[kind]) {
    H("p", "t3", body, "\u672c\u56fe\u65e0\u53ef\u7528\u6570\u636e\u3002");
    return;
  }
  BUILDERS[kind](body, data);
  mounted++;
});

/* ---------------- interactions ---------------- */
/* Default-activate the first resp-block of EVERY section that has one —
   single-response sections have no tab bar, so without this their charts
   would stay display:none forever. */
document.querySelectorAll("section").forEach(function (sec) {
  var blocks = sec.querySelectorAll(".resp-block");
  if (blocks.length && !sec.querySelector(".resp-block.resp-active")) {
    blocks[0].classList.add("resp-active");
  }
});
document.querySelectorAll(".tab-bar").forEach(function (bar) {
  var sec = bar.closest("section");
  if (!sec) return;
  var blocks = sec.querySelectorAll(".resp-block");
  bar.querySelectorAll(".tab-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      bar.querySelectorAll(".tab-btn").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      blocks.forEach(function (b) {
        b.classList.toggle("resp-active", b.getAttribute("data-response") === btn.getAttribute("data-target"));
      });
    });
  });
});
document.querySelectorAll(".toggle-sig").forEach(function (cb) {
  cb.addEventListener("change", function () {
    document.body.classList.toggle("sig-only", cb.checked);
  });
});
var tci = document.getElementById("toggle-ci");
if (tci) {
  tci.addEventListener("change", function () {
    document.body.classList.toggle("hide-ci", !tci.checked);
  });
}
var meta = {};
try { meta = JSON.parse(document.getElementById("report-meta").textContent); } catch (e) { meta = {}; }
