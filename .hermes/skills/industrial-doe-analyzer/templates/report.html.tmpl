    S("text", { x: x, y: T + PH + 16, "text-anchor": "middle", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(v, 4));
  });
  function spec(v, label, color, dash) {
    if (v === null || v === undefined) return;
    var x = lin(v, e0, e1, L, L + PW);
    S("line", { x1: x, y1: T - 6, x2: x, y2: T + PH, stroke: color, "stroke-width": 1.6,
                "stroke-dasharray": dash ? "5 4" : "" }, svg);
    S("text", { x: x + 3, y: T - 9, "font-size": 9.5, fill: color }, svg, label + " " + fmt(v, 4));
  }
  spec(d.lsl, "LSL", C.red, false);
  spec(d.usl, "USL", C.red, false);
  spec(d.target, "T", C.ink, true);
  spec(d.mean, "mean", C.green, true);
