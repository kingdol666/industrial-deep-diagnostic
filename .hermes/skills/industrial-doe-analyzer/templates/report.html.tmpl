BUILDERS.interact = function (el, d) {
  var PW = 640, PH = 300, L = 70, T = 30, Rm = 30;
  var W = L + PW + Rm, H = T + PH + 46;
  var svg = chartSvg(el, W, H);
  var all = [];
  d.series.forEach(function (s) { all = all.concat(s.values); });
  var ymin = Math.min.apply(null, all), ymax = Math.max.apply(null, all);
  if (ymax - ymin === 0) { ymin -= 1; ymax += 1; }
  var pad = (ymax - ymin) * 0.1;
  ymin -= pad; ymax += pad;
  var n = d.xt.length;
  function xpos(i) { return lin(i, 0, n - 1, L + 20, L + PW - 20); }
  for (var k = 0; k <= 4; k++) {
    var gy = T + PH * k / 4;
    S("line", { x1: L, y1: gy, x2: L + PW, y2: gy, stroke: C.grid }, svg);
    S("text", { x: L - 6, y: gy + 3, "text-anchor": "end", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg,
      fmt(ymax - (ymax - ymin) * k / 4, 3));
  }
  d.xt.forEach(function (x, i) {
    S("text", { x: xpos(i), y: T + PH + 18, "text-anchor": "middle", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg,
      x.raw !== null && x.raw !== undefined ? fmt(x.raw, 3) : String(x.level));
  });
  S("text", { x: L + PW / 2, y: T + PH + 36, "text-anchor": "middle", "font-size": 10.5, fill: C.ink }, svg, d.xlabel);
  var cols = [C.ink, C.warm, C.green, C.gold];
  d.series.forEach(function (s, si) {
    var pts = s.values.map(function (v, i) { return xpos(i) + "," + lin(v, ymin, ymax, T + PH, T); }).join(" ");
    S("polyline", { points: pts, fill: "none", stroke: cols[si % cols.length], "stroke-width": 2 }, svg);
    s.values.forEach(function (v, i) {
      var c = S("circle", { cx: xpos(i), cy: lin(v, ymin, ymax, T + PH, T), r: 3.5,
                            fill: cols[si % cols.length] }, svg);
      c.setAttribute("data-tip", d.sname + ": " + s.name + "\n" + d.xlabel + ": " +
        (d.xt[i].raw !== null && d.xt[i].raw !== undefined ? fmt(d.xt[i].raw, 3) : d.xt[i].level) +
        "\npredicted " + d.ylabel + ": " + fmt(v, 5));
    });
    S("text", { x: L + PW + 4, y: lin(s.values[s.values.length - 1], ymin, ymax, T + PH, T) + 3,
                "font-size": 9.5, fill: cols[si % cols.length] }, svg, s.name);
  });
};

BUILDERS.corrheat = function (el, d) {
  var CW = 56, CH = 30, L = 120, T = 46;
  var W = L + d.params.length * CW + 20, H = T + d.targets.length * CH + 30;
  var svg = chartSvg(el, W, H);
  d.params.forEach(function (p, j) {
    S("text", { x: L + j * CW + CW / 2, y: T - 8, "font-size": 9.5, fill: C.t2,
                transform: "rotate(-38 " + (L + j * CW + CW / 2) + " " + (T - 8) + ")", "text-anchor": "start" }, svg, p);
  });
  d.targets.forEach(function (tg, i) {
    S("text", { x: L - 8, y: T + i * CH + CH / 2 + 4, "text-anchor": "end", "font-size": 10.5, fill: C.ink }, svg, tg);
  });
  var drawn = {};
  d.cells.forEach(function (c) { drawn[c.ti + "_" + c.pi] = c; });
  d.targets.forEach(function (tg, i) {
    d.params.forEach(function (p, j) {
      var c = drawn[i + "_" + j];
      var x = L + j * CW, y = T + i * CH;
      var vdot = c && c.r !== null && c.r !== undefined ? c.r : 0;
      var fill = c ? ramp((vdot + 1) / 2) : "#f0efec";
      var rect = S("rect", { x: x, y: y, width: CW - 2, height: CH - 2, rx: 3, fill: fill }, svg);
      if (c) {
        rect.setAttribute("data-tip", c.tip);
        var light = vdot > -0.85 && vdot < 0.6;
        S("text", { x: x + CW / 2 - 1, y: y + CH / 2 + 4, "text-anchor": "middle", "font-size": 9.5,
                    fill: light ? "#222" : "#fff", "class": "mono-lbl" }, svg, fmt(c.r, 3));
        var ring = c.verdict === "PASS" ? C.green : (c.verdict === "CAUTION" ? C.warm : C.red);
        S("circle", { cx: x + CW - 8, cy: y + 8, r: 3.5, fill: "none", stroke: ring, "stroke-width": 2 }, svg);
      }
    });
  });
  var ly = T + d.targets.length * CH + 14;
  [["PASS", C.green], ["CAUTION", C.warm], ["FAIL", C.red]].forEach(function (it, i) {
    S("circle", { cx: L + i * 110 + 5, cy: ly + 4, r: 4, fill: "none", stroke: it[1], "stroke-width": 2 }, svg);
    S("text", { x: L + i * 110 + 14, y: ly + 8, "font-size": 9.5, fill: C.t2 }, svg, it[0]);
  });
};

BUILDERS.dr2 = function (el, d) {
