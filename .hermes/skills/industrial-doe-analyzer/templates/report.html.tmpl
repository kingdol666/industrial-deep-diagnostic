BUILDERS.timeline = function (el, d) {
  var PW = 900, PH = 210, L = 60, T = 16, Rm = 24;
  var W = L + PW + Rm, H = T + PH + 40;
  var svg = chartSvg(el, W, H);
  var vals = d.values.filter(function (v) { return v !== null; });
  var ymin = Math.min.apply(null, vals), ymax = Math.max.apply(null, vals);
  if (ymax - ymin === 0) { ymin -= 1; ymax += 1; }
  var pad = (ymax - ymin) * 0.08;
  ymin -= pad; ymax += pad;
  var n = d.values.length;
  [0, 0.25, 0.5, 0.75, 1].forEach(function (s) {
    var gy = lin(s, 0, 1, T + PH, T);
    S("line", { x1: L, y1: gy, x2: L + PW, y2: gy, stroke: C.grid }, svg);
    S("text", { x: L - 6, y: gy + 3, "text-anchor": "end", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg,
      fmt(ymax - (ymax - ymin) * s, 3));
  });
  d.segments.forEach(function (s) {
    var x0 = lin(s.start / n, 0, 1, L, L + PW), x1 = lin((s.end + 1) / n, 0, 1, L, L + PW);
    var seg = S("rect", { x: x0, y: T, width: Math.max(x1 - x0, 1), height: PH,
                          fill: C.green, opacity: s.selected ? 0.22 : 0.10 }, svg);
    seg.setAttribute("data-tip", "steady segment rows " + s.label +
      (s.selected ? "\nselected for windows" : ""));
  });
  var pts = [];
  d.values.forEach(function (v, i) {
    if (v === null) return;
    pts.push(lin(i / n, 0, 1, L, L + PW) + "," + lin(v, ymin, ymax, T + PH, T));
  });
  S("polyline", { points: pts.join(" "), fill: "none", stroke: C.ink, "stroke-width": 0.8, opacity: 0.9 }, svg);
  d.cps.forEach(function (cp) {
    var x = lin(cp / n, 0, 1, L, L + PW);
    S("line", { x1: x, y1: T, x2: x, y2: T + PH, stroke: C.warm, "stroke-width": 1.2, "stroke-dasharray": "5 4" }, svg);
  });
  S("text", { x: L + PW / 2, y: H - 8, "text-anchor": "middle", "font-size": 9.5, fill: C.t3 }, svg,
    "run order (" + n + " pts" + (d.stride > 1 ? ", 1/" + d.stride + " of " + d.n_total : "") + ")");
};

BUILDERS.hist = function (el, d) {
  var PW = 640, PH = 260, L = 60, T = 24, Rm = 30;
  var W = L + PW + Rm, H = T + PH + 46;
  var svg = chartSvg(el, W, H);
