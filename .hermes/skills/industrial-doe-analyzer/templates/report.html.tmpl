BUILDERS.contour = function (el, d) {
  var PW = 350, PH = 320, L = 64, T = 16, Rm = 60;
  var W = L + PW + Rm + 30, H = T + PH + 54;
  var svg = chartSvg(el, W, H);
  var g = d.z.length, flat = [];
  d.z.forEach(function (row) { row.forEach(function (v) { if (v !== null) flat.push(v); }); });
  var zmin = Math.min.apply(null, flat), zmax = Math.max.apply(null, flat);
  var x0 = -1, x1 = 1;
  for (var a = 0; a < g; a++) {
    for (var b = 0; b < g; b++) {
      var v = d.z[a][b];
      var rx = lin(b, 0, g, L, L + PW), ry = lin(a, 0, g, T + PH, T);
      if (v === null) {
        S("rect", { x: rx, y: ry, width: PW / g + 0.5, height: PH / g + 0.5, fill: "#eee" }, svg);
        continue;
      }
      var t = (zmax - zmin) === 0 ? 0.5 : (v - zmin) / (zmax - zmin);
      var cell = S("rect", { x: rx, y: ry, width: PW / g + 0.6, height: PH / g + 0.6, fill: ramp(t) }, svg);
      cell.setAttribute("data-tip", d.xlabel + " (coded): " + fmt(-1 + 2 * b / (g - 1), 2) +
        "\n" + d.ylabel + " (coded): " + fmt(-1 + 2 * a / (g - 1), 2) +
        "\npredicted: " + fmt(v, 5));
    }
  }
  [0, 0.25, 0.5, 0.75, 1].forEach(function (s, i) {
    var x = lin(s, 0, 1, L, L + PW);
    S("text", { x: x, y: T + PH + 16, "text-anchor": "middle", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(d.xraw[i], 3));
    var y = lin(s, 0, 1, T + PH, T);
    S("text", { x: L - 6, y: y + 3, "text-anchor": "end", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(d.yraw[i], 3));
  });
  S("text", { x: L + PW / 2, y: T + PH + 34, "text-anchor": "middle", "font-size": 10.5, fill: C.ink }, svg, d.xlabel + " (raw)");
  S("text", { x: 14, y: T + PH / 2, "font-size": 10.5, fill: C.ink,
              transform: "rotate(-90 14 " + (T + PH / 2) + ")", "text-anchor": "middle" }, svg, d.ylabel + " (raw)");
  if (d.st && d.st.x !== null && d.st.x !== undefined) {
    var sx = lin((d.st.x + 1) / 2, 0, 1, L, L + PW);
    var sy = lin((d.st.y + 1) / 2, 0, 1, T + PH, T);
    S("rect", { x: sx - 6, y: sy - 6, width: 12, height: 12, fill: "none",
                stroke: C.red, "stroke-width": 2, transform: "rotate(45 " + sx + " " + sy + ")" }, svg);
    S("text", { x: sx + 10, y: sy - 8, "font-size": 10, fill: C.red }, svg,
      ({ max: "\u9A7B\u70B9=max", min: "\u9A7B\u70B9=min", saddle: "\u9A7B\u70B9=saddle" })[d.st.classification] || d.st.classification);
  }
  var lgx = L + PW + 16, lgy = T + 10, lgh = PH - 40;
  var grad = S("linearGradient", { id: "cg" + el.parentNode.parentNode.id }, svg);
  var defs = S("defs", {}, svg);
  defs.appendChild(grad);
  [0, 0.25, 0.5, 0.75, 1].forEach(function (o) {
    var st = document.createElementNS(NS, "stop");
    st.setAttribute("offset", (o * 100) + "%");
    st.setAttribute("stop-color", ramp(1 - o));
    grad.appendChild(st);
  });
  svg.appendChild(defs);
  S("rect", { x: lgx, y: lgy, width: 14, height: lgh, fill: "url(#cg" + el.parentNode.parentNode.id + ")", stroke: C.grid }, svg);
  S("text", { x: lgx + 18, y: lgy + 10, "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(zmax, 4));
  S("text", { x: lgx + 18, y: lgy + lgh, "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(zmin, 4));
