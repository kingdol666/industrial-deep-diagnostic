<div id="tooltip"></div>
<script>
(function () {
"use strict";
var PAYLOAD = JSON.parse(document.getElementById("report-payload").textContent);
var NS = "http://www.w3.org/2000/svg";
var C = { ink: "#1e3a54", warm: "#c2673a", green: "#2d7d4f", red: "#c4433b",
          grey: "#8a8a8a", gold: "#8a6d3b", grid: "rgba(0,0,0,0.08)", t3: "#888" };

function fmt(v, digits) {
  if (v === null || v === undefined) return "\u2014";
  if (typeof v !== "number") return String(v);
  if (!isFinite(v)) return "\u2014";
  var d = digits === undefined ? 4 : digits;
  var s = v.toPrecision(Math.max(1, d));
  if (Math.abs(v) >= 1e5 || (Math.abs(v) < 1e-4 && v !== 0)) {
    var e = v.toExponential(2);
    return e;
  }
  return String(parseFloat(s));
}
function S(tag, attrs, parent, txt) {
  var e = document.createElementNS(NS, tag);
  for (var k in attrs) e.setAttribute(k, attrs[k]);
  if (txt !== null && txt !== undefined) e.textContent = txt;
  if (parent) parent.appendChild(e);
  return e;
}
function H(tag, cls, parent, txt) {
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (txt !== null && txt !== undefined) e.textContent = txt;
  if (parent) parent.appendChild(e);
  return e;
}
function lin(v, d0, d1, r0, r1) {
  if (d1 - d0 === 0) return (r0 + r1) / 2;
  return r0 + (v - d0) * (r1 - r0) / (d1 - d0);
}
function mix(a, b, t) {
  function p(h, i) { return parseInt(h.substr(i, 2), 16); }
  var r = Math.round(p(a, 1) + (p(b, 1) - p(a, 1)) * t);
  var g = Math.round(p(a, 3) + (p(b, 3) - p(a, 3)) * t);
  var bl = Math.round(p(a, 5) + (p(b, 5) - p(a, 5)) * t);
  return "rgb(" + r + "," + g + "," + bl + ")";
}
function ramp(t) { /* ink -> warm paper -> warm */
  if (t < 0.5) return mix("#1e3a54", "#f4f3f0", t * 2);
  return mix("#f4f3f0", "#c2673a", (t - 0.5) * 2);
}
function chartSvg(el, w, h) {
  var svg = S("svg", { viewBox: "0 0 " + w + " " + h, width: w, height: h });
  el.appendChild(svg);
  return svg;
}

/* ---------------- tooltip ---------------- */
var tip = document.getElementById("tooltip");
document.addEventListener("mousemove", function (ev) {
  var t = ev.target;
  while (t && t.getAttribute && !t.getAttribute("data-tip")) t = t.parentNode;
  var msg = t && t.getAttribute ? t.getAttribute("data-tip") : null;
  if (msg) {
    tip.textContent = msg;
    tip.style.display = "block";
    var x = ev.clientX + 14, y = ev.clientY + 14;
    if (x + 440 > window.innerWidth) x = ev.clientX - 440;
    if (y + 180 > window.innerHeight) y = ev.clientY - 120;
    tip.style.left = x + "px";
    tip.style.top = y + "px";
  } else {
    tip.style.display = "none";
  }
});

/* ---------------- builders ---------------- */
var BUILDERS = {};

BUILDERS.pareto = function (el, d) {
  var rows = d.rows.slice().sort(function (a, b) { return (b.t || 0) - (a.t || 0); });
  var L = 180, R = 60, T = 18, rowH = 24;
  var W = 760, H = rows.length * rowH + T + 40;
  var maxT = Math.max.apply(null, rows.map(function (r) { return r.t || 0; }).concat([0.001]));
  var svg = chartSvg(el, W, H);
  var steps = [0, 0.25, 0.5, 0.75, 1];
  steps.forEach(function (s) {
    var x = lin(s * maxT, 0, maxT, L, W - R);
    S("line", { x1: x, y1: T, x2: x, y2: H - 34, stroke: s === 0 ? C.t3 : C.grid, "stroke-width": 1 }, svg);
    S("text", { x: x, y: H - 20, "text-anchor": "middle", "font-size": 10, fill: C.t3 }, svg, fmt(s * maxT, 3));
  });
  if (d.ref !== null && d.ref !== undefined) {
    var xr = lin(d.ref, 0, maxT, L, W - R);
    S("line", { x1: xr, y1: T, x2: xr, y2: H - 34, stroke: C.red, "stroke-width": 1.2, "stroke-dasharray": "5 4" }, svg);
    /* label ABOVE the plot area (T-5): never collides with the longest bar */
    S("text", { x: xr + 4, y: T - 5, "font-size": 10.5, fill: C.red }, svg, "t*=" + fmt(d.ref, 3));
  }
  rows.forEach(function (r, i) {
    var y = T + rowH * i + rowH / 2;
    var w = lin(r.t || 0, 0, maxT, L, W - R) - L;
    var col = r.sig ? C.warm : C.grey;
    S("text", { x: L - 8, y: y + 3, "text-anchor": "end", "font-size": 10.5,
                fill: r.sig ? C.ink : C.t2 }, svg, String(r.term));
    var bar = S("rect", { x: L, y: y - 8, width: Math.max(w, 1), height: 16, rx: 3, fill: col,
                          opacity: r.sig ? 0.95 : 0.65 }, svg);
    bar.setAttribute("data-tip", "term: " + r.term + "\n|t|: " + fmt(r.t, 4) +
      "\ncoef: " + fmt(r.coef) + "\nSE: " + fmt(r.se) + "\nq(BH): " + fmt(r.q, 4) +
      "\npartial eta2: " + fmt(r.eta) + (r.rank ? "\npareto rank: " + r.rank : ""));
    S("text", { x: L + Math.max(w, 1) + 5, y: y + 3, "font-size": 11,
                fill: r.sig ? C.warm : C.t3, "class": "mono-lbl" }, svg, fmt(r.t, 3));
  });
};

BUILDERS.eta = function (el, d) {
  var rows = d.rows;
  var L = 180, R = 70, T = 10, rowH = 22;
  var W = 700, H = rows.length * rowH + T + 26;
  var max = Math.max.apply(null, rows.map(function (r) { return r.eta || 0; }).concat([1e-9]));
  var svg = chartSvg(el, W, H);
  rows.forEach(function (r, i) {
    var y = T + rowH * i + rowH / 2;
    var w = lin(r.eta || 0, 0, max, 0, W - L - R);
    S("text", { x: L - 8, y: y + 3, "text-anchor": "end", "font-size": 10.5, fill: C.t2 }, svg, String(r.term));
    var bar = S("rect", { x: L, y: y - 7, width: Math.max(w, 1), height: 14, rx: 3, fill: C.ink, opacity: 0.85 }, svg);
    bar.setAttribute("data-tip", "term: " + r.term + "\npartial eta2: " + fmt(r.eta, 5) + "\nq(BH): " + fmt(r.q, 4));
    S("text", { x: L + Math.max(w, 1) + 6, y: y + 3, "font-size": 11.5, fill: C.t3, "class": "mono-lbl" }, svg, fmt(r.eta, 3));
  });
};

BUILDERS.resid = function (el, d) {
  var PW = 350, PH = 240, GAP = 24;
  var W = PW * 2 + GAP * 3, H = PH * 2 + GAP * 2;
  var svg = chartSvg(el, W, H);
  var n = d.fitted.length;
  function panel(px, py, title) {
    S("rect", { x: px, y: py, width: PW, height: PH, fill: "#fdfdfc", stroke: C.grid }, svg);
    S("text", { x: px + 10, y: py + 16, "font-size": 11, fill: C.ink }, svg, title);
  }
  function scatter(px, py, xs, ys, tipFn, color) {
    var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs);
    var y0 = Math.min.apply(null, ys), y1 = Math.max.apply(null, ys);
    if (x1 - x0 === 0) { x0 -= 1; x1 += 1; }
    if (y1 - y0 === 0) { y0 -= 1; y1 += 1; }
    var pad = 0.08;
    x0 -= (x1 - x0) * pad; x1 += (x1 - x0) * pad;
    y0 -= (y1 - y0) * pad; y1 += (y1 - y0) * pad;
    var ox = px + 42, oy = py + 30, iw = PW - 58, ih = PH - 52;
    for (var k = 0; k <= 4; k++) {
      var gy = oy + ih * k / 4;
      S("line", { x1: ox, y1: gy, x2: ox + iw, y2: gy, stroke: C.grid }, svg);
      var gx = ox + iw * k / 4;
      S("line", { x1: gx, y1: oy, x2: gx, y2: oy + ih, stroke: C.grid }, svg);
    }
    xs.forEach(function (xv, i) {
      var c = S("circle", { cx: lin(xv, x0, x1, ox, ox + iw), cy: lin(ys[i], y0, y1, oy + ih, oy),
                            r: 2.6, fill: color || C.ink, opacity: 0.8 }, svg);
      if (tipFn) c.setAttribute("data-tip", tipFn(i));
    });
    return { ox: ox, oy: oy, iw: iw, ih: ih, x0: x0, x1: x1, y0: y0, y1: y1 };
  }
  var r0 = d.resid;
  /* panel() (opaque backing + title) MUST be painted BEFORE each panel's
     data: it fills the full panel rect and would otherwise cover everything. */
  panel(GAP, GAP, "Residuals vs fitted");
  var p1 = scatter(GAP, GAP, d.fitted, r0, function (i) {
    var row = d.rows[i] || {};
    return "row " + row.row_index + "\ny: " + fmt(row.y) + "\nyhat: " + fmt(row.yhat) + "\nresid: " + fmt(row.resid);
  });
  S("line", { x1: p1.ox, y1: lin(0, p1.y0, p1.y1, p1.oy + p1.ih, p1.oy),
              x2: p1.ox + p1.iw, y2: lin(0, p1.y0, p1.y1, p1.oy + p1.ih, p1.oy),
              stroke: C.red, "stroke-width": 1.2 }, svg);
  panel(PW + GAP * 2, GAP, "Normal Q-Q");
  if (d.qq.length > 1) {
    var qxs = d.qq.map(function (p) { return p[0]; });
    var qys = d.qq.map(function (p) { return p[1]; });
    var p2 = scatter(PW + GAP * 2, GAP, qxs, qys, null);
    S("line", { x1: lin(qxs[0], p2.x0, p2.x1, p2.ox, p2.ox + p2.iw), y1: lin(qys[0], p2.y0, p2.y1, p2.oy + p2.ih, p2.oy),
                x2: lin(qxs[qxs.length - 1], p2.x0, p2.x1, p2.ox, p2.ox + p2.iw),
                y2: lin(qys[qys.length - 1], p2.y0, p2.y1, p2.oy + p2.ih, p2.oy),
                stroke: C.t3, "stroke-dasharray": "4 3" }, svg);
