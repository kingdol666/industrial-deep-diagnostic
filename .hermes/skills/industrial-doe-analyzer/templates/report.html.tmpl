    var gy = lin(s, 0, 1, T + PH, T);
    S("line", { x1: L, y1: gy, x2: L + PW, y2: gy, stroke: C.grid }, svg);
    S("text", { x: L - 6, y: gy + 3, "text-anchor": "end", "font-size": 9.5, fill: C.t3, "class": "mono-lbl" }, svg,
      fmt(maxC * (1 - s), 0));
  });
  counts.forEach(function (c, i) {
    var bx0 = lin(edges[i], e0, e1, L, L + PW), bx1 = lin(edges[i + 1], e0, e1, L, L + PW);
    var bh2 = PH * c / maxC;
    var b = S("rect", { x: bx0 + 1, y: T + PH - bh2, width: Math.max(bx1 - bx0 - 2, 1), height: bh2,
                        fill: C.ink, opacity: 0.82 }, svg);
    b.setAttribute("data-tip", "bin [" + fmt(edges[i], 4) + ", " + fmt(edges[i + 1], 4) + ")\ncount: " + c);
  });
  [e0, (e0 + e1) / 2, e1].forEach(function (v) {
