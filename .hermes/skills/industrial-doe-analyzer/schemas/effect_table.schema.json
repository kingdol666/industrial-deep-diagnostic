{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Designed-mode effect table (extra-SS ANOVA + BH-FDR)",
  "type": "object",
  "required": ["generated_at", "mode", "model_spec", "coding", "families", "multiple_testing"],
  "properties": {
    "generated_at": { "type": "string" },
    "mode": { "const": "designed" },
    "model_spec": {
      "type": "object",
      "required": ["main_effects", "interactions", "quadratic"],
      "properties": {
        "main_effects": { "type": "array", "items": { "type": "string" } },
        "interactions": { "type": "array", "items": { "type": "string" } },
        "quadratic": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "covariates": { "type": "array", "items": { "type": "string" } },
        "pooled_terms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coding": {
      "type": "object",
      "required": ["method", "continuous_scaling"],
      "properties": {
        "method": { "enum": ["deviation"] },
        "continuous_scaling": { "type": "string" },
        "columns": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["response", "tests", "df_resid", "r_squared"],
        "properties": {
          "response": { "type": "string" },
          "n": { "type": "integer" },
          "df_resid": { "type": "integer", "minimum": 0 },
          "df_pure_error": { "type": ["integer", "null"] },
          "df_lack_of_fit": { "type": ["integer", "null"] },
          "mse": { "type": ["number", "null"] },
          "mse_pure_error": { "type": ["number", "null"] },
          "sigma_pure_error": { "type": ["number", "null"] },
          "r_squared": { "type": "number" },
          "adj_r_squared": { "type": ["number", "null"] },
          "q_squared_loo": { "type": ["number", "null"] },
          "mde": { "type": ["number", "null"] },
          "mde_note": { "type": ["string", "null"] },
          "saturated": { "type": ["boolean", "null"] },
          "lack_of_fit": { "type": ["object", "null"] },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["term", "coefficient", "estimable", "n"],
              "properties": {
                "term": { "type": "string" },
                "order": { "type": "integer" },
                "coefficient": { "type": ["number", "null"] },
                "std_err": { "type": ["number", "null"] },
                "df": { "type": ["integer", "null"] },
                "ss_extra_ss": { "type": ["number", "null"] },
                "f_stat": { "type": ["number", "null"] },
                "p_value": { "type": ["number", "null"] },
                "q_value_bh": { "type": ["number", "null"] },
                "eta_squared": { "type": ["number", "null"] },
                "partial_eta_squared": { "type": ["number", "null"] },
                "effect_size_std": { "type": ["number", "null"] },
                "pareto_rank": { "type": ["integer", "null"] },
                "estimable": { "type": "boolean" },
                "reason_code": { "enum": [null, "aliased", "saturated", "zero_variance", "pooled"] },
                "alias_chain": { "type": "array", "items": { "type": "string" } },
                "n": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "multiple_testing": {
      "type": "object",
      "required": ["method", "n_families", "total_tests", "total_significant_q05"],
      "properties": {
        "method": { "const": "BH" },
        "n_families": { "type": "integer" },
        "total_tests": { "type": "integer" },
        "total_significant_q05": { "type": "integer" },
        "excluded_from_family": { "type": "integer" }
      }
    }
  }
}
