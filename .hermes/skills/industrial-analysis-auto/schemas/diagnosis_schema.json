{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnosis Schema v6.0",
  "description": "Schema for the Diagnostician agent's primary output (Competing Hypotheses Protocol)",
  "type": "object",
  "required": ["run_id", "diagnosis_time", "diagnosis_type", "primary_finding", "hypotheses"],
  "properties": {
    "run_id": {"type": "string"},
    "diagnosis_time": {"type": "string", "format": "date-time"},
    "diagnosis_type": {
      "type": "string",
      "enum": ["DETERMINED", "COMPETING_SET", "NEEDS_DATA"],
      "description": "DETERMINED: single hypothesis survives all exclusion. COMPETING_SET: multiple indistinguishable hypotheses. NEEDS_DATA: no hypothesis meets minimum evidence threshold."
    },
    "primary_finding": {
      "type": "string",
      "description": "One-sentence summary of the primary diagnostic finding"
    },
    "process_fluctuation_analysis": {
      "type": "object",
      "description": "Diagnosis path A: pure process-data fluctuation analysis, without requiring defect/anomaly linkage as the starting point",
      "properties": {
        "analysis_performed": {"type": "boolean"},
        "scope": {"type": "string", "enum": ["process_only", "process_with_time", "process_with_grouping", "not_applicable"]},
        "grouping_basis": {"type": "string"},
        "time_order_basis": {"type": "string"},
        "key_process_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parameter": {"type": "string"},
              "behavior_type": {"type": "string", "enum": ["drift", "high_variability", "step_change", "threshold_crossing", "regime_switch", "cyclic", "stable"]},
              "affected_group": {"type": "string"},
              "evidence": {"type": "string"},
              "ontology_interpretation": {"type": "string"},
              "physics_mechanism": {"type": "string"},
              "diagnostic_implication": {"type": "string"}
            }
          }
        },
        "ontology_physics_reasoning": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parameter": {"type": "string"},
              "ontology_role": {"type": "string"},
              "governing_law": {"type": "string"},
              "reasoning_summary": {"type": "string"},
              "proof_strength": {"type": "string", "enum": ["PROVEN", "STRONG_EVIDENCE", "SUPPORTIVE", "WEAK", "CONTRADICTED"]}
            }
          }
        },
        "conclusion": {"type": "string"}
      }
    },
    "integrated_dual_drive_analysis": {
      "type": "object",
      "description": "Diagnosis path B: combined process + inspection/quality anomaly analysis",
      "properties": {
        "analysis_performed": {"type": "boolean"},
        "has_quality_or_inspection_targets": {"type": "boolean"},
        "linked_groups": {
          "type": "array",
          "items": {"type": "string"}
        },
        "process_to_quality_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {"type": "string"},
              "process_parameter": {"type": "string"},
              "quality_target": {"type": "string"},
              "link_type": {"type": "string", "enum": ["same_window", "process_precedes_quality", "coincident", "between_group_only", "unclear"]},
              "statistical_evidence": {"type": "string"},
              "anomaly_evidence": {"type": "string"},
              "ontology_physics_reasoning": {"type": "string"},
              "diagnostic_weight": {"type": "string", "enum": ["critical", "strong", "moderate", "weak"]}
            }
          }
        },
        "integrated_conclusion": {"type": "string"}
      }
    },
    "product_stratified_analysis": {
      "type": "object",
      "description": "Per-product stratification results when product column exists",
      "properties": {
        "has_product_column": {"type": "boolean"},
        "products_found": {
          "type": "array",
          "items": {"type": "string"}
        },
        "overall_vs_per_product_comparison": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parameter": {"type": "string"},
              "overall_r": {"type": "number"},
              "per_product_r": {
                "type": "object",
                "additionalProperties": {"type": "number"}
              },
              "consistency_class": {
                "type": "string",
                "enum": ["UNIVERSAL", "CONSISTENT_SIGN", "CONSISTENT_WEAK", "PRODUCT_SPECIFIC", "SIMPSON_REVERSAL", "BETWEEN_PRODUCT_ONLY"]
              },
              "conclusion": {"type": "string"}
            }
          }
        },
        "analysis_scope": {
          "type": "string",
          "enum": ["overall_only", "overall_and_per_product"]
        }
      }
    },
    "hypotheses": {
      "type": "object",
      "required": ["surviving", "eliminated"],
      "properties": {
        "surviving": {
          "type": "array",
          "description": "Hypotheses that survived elimination (DETERMINED case: single entry)",
          "items": {
            "type": "object",
            "required": ["id", "name", "mechanism_class", "confidence", "physical_logic_chain", "ontology_data_physics_proof", "chain_link_validation", "falsification_conditions"],
            "properties": {
              "id": {"type": "string", "pattern": "^H[0-9]+$"},
              "name": {"type": "string"},
              "mechanism_class": {
                "type": "string",
                "enum": ["WEAR", "DRIFT", "CONTAMINATION", "OPERATION", "ENVIRONMENT", "INTERACTION"]
              },
              "root_physical_cause": {"type": "string"},
              "physical_logic_chain": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "link": {"type": "string"},
                    "evidence_status": {"type": "string", "enum": ["OBSERVED", "KNOWN_PHYSICS", "INFERRED", "UNVERIFIED"]},
                    "quantification": {"type": "string"}
                  }
                }
              },
              "chain_quality": {
                "type": "string",
                "enum": ["ACTIONABLE_HYPOTHESIS", "PLAUSIBLE_HYPOTHESIS", "RESEARCH_QUESTION"]
              },
              "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
              "confidence_adjustments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reason": {"type": "string"},
                    "adjustment": {"type": "integer"},
                    "source": {"type": "string"}
                  }
                }
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rank": {"type": "integer", "minimum": 1, "maximum": 7},
                    "source": {"type": "string"},
                    "detail": {"type": "string"}
                  }
                }
              },
              "visual_evidence": {
                "type": "object",
                "description": "VLM visual observations supporting this hypothesis",
                "properties": {
                  "synchronous_with_quality": {"type": "boolean", "description": "Whether visual_analysis.json reports this parameter in a synchronous group with quality"},
                  "event_response": {"type": "string", "description": "How this parameter visually responds to events"},
                  "trend_alignment": {"type": "string", "description": "aligned_with_quality_decline | independent | opposite"},
                  "vlm_observations": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Specific VLM observations from visual_analysis.json about this parameter"
                  },
                  "temporal_alignment_group": {"type": "string", "description": "Which synchronous group this parameter belongs to, from visual_analysis.json"}
                }
              },
              "ontology_data_physics_proof": {
                "type": "object",
                "description": "Per-hypothesis proof that ontology semantics, observed data behavior, and physical mechanism agree or explicitly contradict.",
                "required": ["functional_form_match", "lag_match", "magnitude_ratio", "direction_match", "overall_proof_strength", "proof_summary"],
                "properties": {
                  "functional_form_match": {
                    "type": "string",
                    "enum": ["MATCH", "PARTIAL", "MISMATCH", "UNTESTED"]
                  },
                  "lag_match": {
                    "type": "string",
                    "enum": ["MATCH", "PARTIAL", "MISMATCH", "NOT_APPLICABLE", "UNTESTED"]
                  },
                  "magnitude_ratio": {
                    "type": "object",
                    "required": ["status", "observed_over_predicted"],
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": ["PLAUSIBLE", "BORDERLINE", "IMPLAUSIBLE", "UNTESTED"]
                      },
                      "observed_over_predicted": {
                        "type": ["number", "string", "null"],
                        "description": "Numeric ratio when available, otherwise a short reason such as no quantitative law available."
                      },
                      "evidence_source": {"type": "string"}
                    }
                  },
                  "direction_match": {
                    "type": "string",
                    "enum": ["MATCH", "MISMATCH", "NOT_APPLICABLE", "UNTESTED"]
                  },
                  "overall_proof_strength": {
                    "type": "string",
                    "enum": ["PROVEN", "STRONG_EVIDENCE", "SUPPORTIVE", "WEAK", "CONTRADICTED"]
                  },
                  "proof_summary": {"type": "string"},
                  "data_sources": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "physics_sources": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "ontology_sources": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              },
              "chain_link_validation": {
                "type": "object",
                "description": "v2.0: Per-link validation of each causal-chain arrow. Prevents J/W-ratio-style gaps where physical reasoning has no data support.",
                "required": ["validation_performed", "links", "overall_result"],
                "properties": {
                  "validation_performed": {"type": "boolean"},
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["from", "to", "mechanism", "result"],
                      "properties": {
                        "from": {"type": "string", "description": "Cause-side data column or physical quantity"},
                        "to": {"type": "string", "description": "Effect-side data column or physical quantity"},
                        "mechanism": {"type": "string", "description": "Physical mechanism connecting the link"},
                        "result": {"type": "string", "enum": ["ALL_LINKS_VALIDATED", "DATA_LINK_MISSING", "CORRELATION_ABSENT", "DIRECTION_MISMATCH", "MAGNITUDE_IMPLAUSIBLE"]},
                        "r": {"type": "number", "description": "Pearson correlation if available"},
                        "p": {"type": "number", "description": "p-value if available"},
                        "note": {"type": "string", "description": "Human-readable explanation"}
                      }
                    }
                  },
                  "overall_result": {"type": "string", "enum": ["ALL_LINKS_VALIDATED", "DATA_LINK_MISSING", "CORRELATION_ABSENT", "DIRECTION_MISMATCH", "MAGNITUDE_IMPLAUSIBLE", "PARTIAL"]},
                  "correction_applied": {"type": "string", "description": "If CORRELATION_ABSENT, what correction was applied (e.g. removed unsupported intermediate, revised mechanism)"}
                }
              },
              "contradicting_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "detail": {"type": "string"},
                    "significance": {"type": "string"}
                  }
                }
              },
              "predicted_observables": {
                "type": "array",
                "items": {"type": "string"}
              },
              "falsification_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "consistency_across_products": {
                "type": "string",
                "enum": ["UNIVERSAL", "CONSISTENT_SIGN", "CONSISTENT_WEAK", "PRODUCT_SPECIFIC"]
              },
              "product_specific_notes": {"type": "object"}
            }
          }
        },
        "competing_sets": {
          "type": "array",
          "description": "Groups of indistinguishable hypotheses (COMPETING_SET diagnosis only)",
          "items": {
            "type": "object",
            "required": ["set_id", "hypotheses", "discriminability"],
            "properties": {
              "set_id": {"type": "string", "pattern": "^CS[0-9]+$"},
              "hypotheses": {
                "type": "array",
                "items": {"type": "string", "pattern": "^H[0-9]+$"}
              },
              "discriminability": {
                "type": "string",
                "enum": ["INDISTINGUISHABLE", "PARTIALLY_DISCRIMINABLE"]
              },
              "cross_product_discriminability": {
                "type": "string",
                "enum": ["REMAINS_INDISTINGUISHABLE", "PARTIALLY_DISCRIMINABLE", "DISCRIMINABLE"]
              },
              "reason": {"type": "string"},
              "discriminating_data_needed": {"type": "string"},
              "confidence_ceiling": {"type": "integer", "default": 65}
            }
          }
        },
        "eliminated": {
          "type": "array",
          "description": "Hypotheses definitively ruled out",
          "items": {
            "type": "object",
            "required": ["hypothesis_id", "exclusion_type", "specific_evidence"],
            "properties": {
              "hypothesis_id": {"type": "string"},
              "exclusion_type": {
                "type": "string",
                "enum": ["PHYSICAL", "STATISTICAL", "COMBINED"]
              },
              "subtype": {
                "type": "string",
                "enum": ["BETWEEN_PRODUCT_ONLY", "SIMPSON_REVERSAL", "PRODUCT_SPECIFIC_ONLY", null]
              },
              "specific_evidence": {"type": "string"},
              "exclusion_confidence": {"type": "integer", "minimum": 90, "maximum": 100},
              "revival_condition": {"type": "string"}
            }
          }
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "description": "Aggregated evidence inventory by type",
      "properties": {
        "visual_evidence_count": {"type": "integer"},
        "numerical_evidence_count": {"type": "integer"},
        "physical_evidence_count": {"type": "integer"},
        "validation_evidence_count": {"type": "integer"}
      }
    },
    "data_gaps": {
      "type": "array",
      "description": "Missing data that limits the diagnosis",
      "items": {"type": "string"}
    },
    "inference_gaps": {
      "type": "array",
      "description": "v2.0: Causal-chain links that were found to have no data support (CORRELATION_ABSENT or DATA_LINK_MISSING from chain_link_validation). These are gaps that the diagnostician consciously acknowledged and either corrected or disclosed, rather than silently ignored.",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "missing_link", "original_chain_segment", "corrected_mechanism", "impact_on_diagnosis"],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "missing_link": {"type": "string", "description": "e.g., 'pressure → J/W ratio'"},
          "result": {"type": "string", "enum": ["CORRELATION_ABSENT", "DATA_LINK_MISSING"]},
          "original_chain_segment": {"type": "string"},
          "corrected_mechanism": {"type": "string", "description": "How this gap was addressed in the final diagnosis"},
          "impact_on_diagnosis": {"type": "string", "description": "Did this cause a DETERMINED→COMPETING_SET downgrade? Confidence reduction?"},
          "statistical_detail": {"type": "string", "description": "r, p-value, notes from feature_summary"}
        }
      }
    },
    "discriminability_matrix": {
      "type": "array",
      "description": "Pairwise discriminability assessment between all competing hypotheses",
      "items": {
        "type": "object",
        "properties": {
          "pair": {"type": "array", "items": {"type": "string", "pattern": "^H[0-9]+$"}, "minItems": 2, "maxItems": 2},
          "classification": {
            "type": "string",
            "enum": ["INDISTINGUISHABLE", "PARTIALLY_DISCRIMINABLE", "DISCRIMINABLE", "ONE_SIDE_EXCLUDED"]
          },
          "discriminating_signal": {"type": "string"},
          "discriminating_signal_available": {"type": "boolean"},
          "cross_product_finding": {"type": "string"}
        }
      }
    }
  }
}
