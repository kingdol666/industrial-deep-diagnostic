{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Data Analysis Conclusion Schema v1.0",
  "description": "Structured expert data-analysis conclusion produced by Data Processor. It summarizes baseline-script results, custom scenario analysis, ontology/industry-knowledge interpretation, and evidence handed to Diagnostician.",
  "type": "object",
  "required": [
    "run_id",
    "generated_at",
    "analysis_mode",
    "baseline_script_results",
    "expert_custom_analysis",
    "ontology_industry_interpretation",
    "data_supported_conclusions",
    "handoff_to_diagnostician"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_mode": {
      "type": "string",
      "enum": ["baseline_plus_custom", "baseline_only_with_justification", "custom_only_emergency"],
      "description": "How the Data Processor combined fixed scripts and expert-written analysis."
    },
    "baseline_script_results": {
      "type": "object",
      "required": ["scripts_run", "key_findings", "limitations"],
      "properties": {
        "scripts_run": {
          "type": "array",
          "items": {"type": "string"}
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding": {"type": "string"},
              "source": {"type": "string"},
              "evidence_rank": {"type": "integer", "minimum": 1, "maximum": 7}
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "expert_custom_analysis": {
      "type": "object",
      "required": ["custom_scripts_written", "script_inventory", "analysis_questions", "custom_outputs", "why_needed"],
      "properties": {
        "custom_scripts_written": {"type": "boolean"},
        "script_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "script": {"type": "string"},
              "purpose": {"type": "string"},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "analysis_questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "custom_outputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "why_needed": {"type": "string"}
      }
    },
    "ontology_industry_interpretation": {
      "type": "array",
      "description": "How ontology and industry knowledge change the interpretation of raw data findings.",
      "items": {
        "type": "object",
        "required": ["parameter_or_pattern", "ontology_role", "industry_knowledge", "interpretation"],
        "properties": {
          "parameter_or_pattern": {"type": "string"},
          "ontology_role": {"type": "string"},
          "industry_knowledge": {"type": "string"},
          "interpretation": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "data_supported_conclusions": {
      "type": "array",
      "description": "Conclusions supported by data analysis before final diagnosis.",
      "items": {
        "type": "object",
        "required": ["conclusion", "supporting_sources", "evidence_strength", "diagnostic_relevance"],
        "properties": {
          "conclusion": {"type": "string"},
          "supporting_sources": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_strength": {
            "type": "string",
            "enum": ["strong", "moderate", "weak", "inconclusive"]
          },
          "diagnostic_relevance": {"type": "string"},
          "known_caveats": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "handoff_to_diagnostician": {
      "type": "object",
      "required": ["priority_hypothesis_inputs", "evidence_gaps", "recommended_diagnostic_focus"],
      "properties": {
        "priority_hypothesis_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate": {"type": "string"},
              "why_prioritized": {"type": "string"},
              "supporting_artifacts": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "recommended_diagnostic_focus": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
