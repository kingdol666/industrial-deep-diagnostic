    <Box style={{ width: 1160, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(29,27,22,0.45)' }}>只有「查看」没有「阅读报告」，说明该次运行没产出报告</Text>
        <Text style={{ fontSize: 14, color: 'rgba(29,27,22,0.45)' }}>22 / 31</Text>
