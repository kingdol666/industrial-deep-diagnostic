<Slide style={{ padding: '22px 64px 18px 64px', background: '#F7F4EC' }}>
    <Box style={{ width: 1152, height: 102, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1D1B16', lineHeight: 1.25 }}>第 3 步 · 搜索并选中 DeepSeek</Text>
            <Text style={{ fontSize: 17, color: 'rgba(29,27,22,0.72)', marginTop: 6 }}>不用翻列表。在服务商列表里直接打字，输入框会变成搜索框，实时过滤</Text>
        </Box>
        <Box style={{ padding: '10px 18px', background: '#B8730F', borderRadius: 8 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>DeepSeek 在 API 分组</Text>
        </Box>
    </Box>
    <Box style={{ width: 1152, height: 534, flexDirection: 'column', gap: 16 }}>
        <Box style={{ height: 125, justifyContent: 'center', alignItems: 'center' }}>
            <Image src="assets/omp_deepseek.png" style={{ width: 937, height: 125, borderRadius: 10, border: '1px solid rgba(29,27,22,0.10)' }} />
        </Box>
        <Box style={{ height: 291, justifyContent: 'center', alignItems: 'center' }}>
            <Image src="assets/omp_providers.png" style={{ width: 937, height: 291, borderRadius: 10, border: '1px solid rgba(29,27,22,0.10)' }} />
        </Box>
        <Box style={{ height: 86, flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 1, padding: 14, background: '#FFFFFF', borderRadius: 11, border: '1px solid rgba(29,27,22,0.10)' }}>
                <Text style={{ fontSize: 18, color: 'rgba(29,27,22,0.80)', lineHeight: 1.5 }}>上面：打 deepseek 后只剩一条，❯ 是光标位置</Text>
            </Box>
            <Box style={{ flex: 1, padding: 14, background: 'rgba(184,115,15,0.10)', borderRadius: 11, border: '1px solid rgba(184,115,15,0.42)' }}>
                <Text style={{ fontSize: 18, color: 'rgba(29,27,22,0.84)', lineHeight: 1.5 }}>下面：没搜索时列表很长，DeepSeek 排在偏后，直接打字更快</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ width: 1152, height: 44, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 15, color: 'rgba(29,27,22,0.48)' }}>绿色 ● logged in (api key) 表示本机已经配过 DeepSeek 的 Key</Text>
        <Text style={{ fontSize: 15, color: 'rgba(29,27,22,0.48)' }}>10 / 40</Text>
    </Box>
</Slide>
