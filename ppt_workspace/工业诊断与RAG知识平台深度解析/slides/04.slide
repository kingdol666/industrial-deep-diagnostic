        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0D9488', fontFamily: 'Cascadia Mono', lineHeight: 1.0 }}>5/6</Text>
        <Box style={{ flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F172A' }}>TEP 故障场景 Top-1 命中</Text>
          <Text style={{ fontSize: 11, color: '#64748B', lineHeight: 1.5 }}>田纳西-伊士曼过程，6 个可归因故障</Text>
        </Box>
      </Box>

      <Box style={{ flex: 1, background: '#F0FDFA', border: '1px solid #99F6E4', borderRadius: 10, padding: '10px 14px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0D9488', fontFamily: 'Cascadia Mono', lineHeight: 1.0 }}>1/1</Text>
        <Box style={{ flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F172A' }}>IndPenSim 批次偏差定位正确</Text>
