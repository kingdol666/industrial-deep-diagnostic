      <Box style={{ flex: 1, background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 10, padding: '10px 14px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Cascadia Mono', lineHeight: 1.0 }}>96</Text>
        <Box style={{ flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F172A' }}>Judge 评分 · ENDORSED</Text>
          <Text style={{ fontSize: 11, color: '#64748B', lineHeight: 1.5 }}>十维评分通过并经物理终审签署</Text>
