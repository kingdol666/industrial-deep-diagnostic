  <Box style={{ height: 14 }} />

  <Box style={{ height: 120, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 10, padding: '12px 18px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
