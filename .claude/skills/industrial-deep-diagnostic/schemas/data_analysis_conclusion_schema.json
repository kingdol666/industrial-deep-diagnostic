{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Data Analysis Conclusion Schema v1.0",
  "description": "Structured expert data-analysis conclusion produced by Data Processor. It summarizes baseline-script results, custom scenario analysis, ontology/industry-knowledge interpretation, and evidence handed to Diagnostician.",
  "type": "object",
  "required": [
    "run_id",
    "generated_at",
    "analysis_mode",
    "baseline_script_results",
    "expert_custom_analysis",
    "ontology_industry_interpretation",
    "adaptive_decision_audit",
    "analysis_coverage_matrix",
    "data_supported_conclusions",
    "handoff_to_diagnostician",
    "time_lag_analysis",
    "analysis_boundary"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_mode": {
      "type": "string",
      "enum": ["ontology_guided_baseline", "ontology_guided_plus_custom", "baseline_plus_custom", "baseline_only_with_justification", "custom_only_emergency"],
      "description": "How the Data Processor combined ontology guidance, fixed scripts, and expert-written analysis."
    },
    "baseline_script_results": {
      "type": "object",
      "required": ["scripts_run", "key_findings", "limitations"],
      "properties": {
        "scripts_run": {
          "type": "array",
          "items": {"type": "string"}
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding": {"type": "string"},
              "source": {"type": "string"},
              "evidence_rank": {"type": "integer", "minimum": 1, "maximum": 7}
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "expert_custom_analysis": {
      "type": "object",
      "required": ["custom_scripts_written", "script_inventory", "analysis_questions", "custom_outputs", "why_needed"],
      "properties": {
        "custom_scripts_written": {"type": "boolean"},
        "script_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "script": {"type": "string"},
              "purpose": {"type": "string"},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "analysis_questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "custom_outputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "why_needed": {"type": "string"}
      }
    },
    "ontology_industry_interpretation": {
      "type": "array",
      "description": "How ontology and industry knowledge change the interpretation of raw data findings.",
      "items": {
        "type": "object",
        "required": ["parameter_or_pattern", "ontology_role", "industry_knowledge", "interpretation"],
        "properties": {
          "parameter_or_pattern": {"type": "string"},
          "ontology_role": {"type": "string"},
          "industry_knowledge": {"type": "string"},
          "interpretation": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "adaptive_decision_audit": {
      "type": "object",
      "description": "Machine-readable proof that Data Processor selected analyses from the actual data shape instead of only running a fixed checklist.",
      "required": ["data_view_mode", "mode_justification", "data_shapes_detected", "selected_analyses", "skipped_or_not_applicable", "custom_analysis_required", "expert_review_summary"],
      "properties": {
        "data_view_mode": {
          "type": "string",
          "enum": ["process_plus_inspection", "process_only", "inspection_only", "unknown"]
        },
        "mode_justification": {"type": "string"},
        "data_shapes_detected": {
          "type": "array",
          "items": {"type": "string"}
        },
        "selected_analyses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["analysis", "reason", "evidence_artifacts"],
            "properties": {
              "analysis": {"type": "string"},
              "reason": {"type": "string"},
              "evidence_artifacts": {"type": "array", "items": {"type": "string"}},
              "coverage_status": {"type": "string", "enum": ["covered", "partial", "planned"]}
            }
          }
        },
        "skipped_or_not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["analysis", "status", "reason"],
            "properties": {
              "analysis": {"type": "string"},
              "status": {"type": "string", "enum": ["skipped", "not_applicable"]},
              "reason": {"type": "string"}
            }
          }
        },
        "custom_analysis_required": {"type": "boolean"},
        "custom_analysis_reason": {"type": "string"},
        "expert_review_summary": {"type": "string"}
      }
    },
    "analysis_coverage_matrix": {
      "type": "object",
      "description": "Coverage status for expert industrial data-analysis dimensions.",
      "required": ["pure_process_analysis", "process_inspection_dual_drive", "grouping_confounding", "temporal_regime_event", "scenario_specific"],
      "properties": {
        "pure_process_analysis": {"type": "object", "required": ["status", "evidence_artifacts", "summary"], "properties": {"status": {"type": "string", "enum": ["covered", "partial", "not_applicable", "missing"]}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}}},
        "process_inspection_dual_drive": {"type": "object", "required": ["status", "evidence_artifacts", "summary"], "properties": {"status": {"type": "string", "enum": ["covered", "partial", "not_applicable", "missing"]}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}}},
        "grouping_confounding": {"type": "object", "required": ["status", "evidence_artifacts", "summary"], "properties": {"status": {"type": "string", "enum": ["covered", "partial", "not_applicable", "missing"]}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}}},
        "temporal_regime_event": {"type": "object", "required": ["status", "evidence_artifacts", "summary"], "properties": {"status": {"type": "string", "enum": ["covered", "partial", "not_applicable", "missing"]}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}}},
        "scenario_specific": {"type": "object", "required": ["status", "evidence_artifacts", "summary"], "properties": {"status": {"type": "string", "enum": ["covered", "partial", "not_applicable", "missing"]}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "data_supported_conclusions": {
      "type": "array",
      "description": "Conclusions supported by data analysis before final diagnosis.",
      "items": {
        "type": "object",
        "required": ["conclusion", "supporting_sources", "evidence_strength", "diagnostic_relevance"],
        "properties": {
          "conclusion": {"type": "string"},
          "supporting_sources": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_strength": {
            "type": "string",
            "enum": ["strong", "moderate", "weak", "inconclusive"]
          },
          "diagnostic_relevance": {"type": "string"},
          "known_caveats": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "handoff_to_diagnostician": {
      "type": "object",
      "required": ["priority_hypothesis_inputs", "evidence_gaps", "recommended_diagnostic_focus"],
      "properties": {
        "priority_hypothesis_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate": {"type": "string"},
              "why_prioritized": {"type": "string"},
              "supporting_artifacts": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "recommended_diagnostic_focus": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "time_lag_analysis": {
      "type": "object",
      "description": "v6.4 TIME-LAG: Auto-detected process-to-inspection time lags. Required when a time column exists and process+inspection data are both present. Queries time_lag_compensator.mjs output (time_lag_analysis.json) and integrates with ontology expected_lag.",
      "required": ["applicable", "pairs_analyzed", "significant_lags_found", "key_recommendations"],
      "properties": {
        "applicable": {"type": "boolean"},
        "not_applicable_reason": {"type": "string"},
        "sampling_interval_seconds": {"type": "number"},
        "max_lag_searched": {"type": "object", "properties": {"steps": {"type": "integer"}, "seconds": {"type": "number"}}},
        "pairs_analyzed": {"type": "integer"},
        "significant_lags_found": {"type": "integer"},
        "physics_consistent_count": {"type": "integer"},
        "physics_discrepancy_count": {"type": "integer"},
        "no_physics_prior_count": {"type": "integer"},
        "key_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predictor": {"type": "string"},
              "target": {"type": "string"},
              "optimal_lag_steps": {"type": "integer"},
              "optimal_lag_seconds": {"type": "number"},
              "confidence": {"type": "string"},
              "raw_r": {"type": "number"},
              "lag_compensated_r": {"type": "number"},
              "r_improvement_pct": {"type": "number"},
              "physics_agreement": {"type": "string"},
              "interpretation": {"type": "string"}
            }
          }
        },
        "key_recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pair": {"type": "string"},
              "recommended_lag_steps": {"type": "integer"},
              "recommended_lag_seconds": {"type": "number"},
              "action": {"type": "string"}
            }
          }
        },
        "physics_discrepancy_alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pair": {"type": "string"},
              "agreement": {"type": "string"},
              "message": {"type": "string"},
              "expected_lag_raw": {"type": "string"},
              "observed_lag_seconds": {"type": "number"}
            }
          }
        }
      }
    },
    "analysis_boundary": {
      "type": "object",
      "description": "Phase 0.4 ontology-guided analysis boundary — what was analyzed, what was pruned, and why. Populated from analysis_parameter_selection.json when Phase 0.4 ran.",
      "oneOf": [
        {
          "type": "object",
          "required": ["tiers", "pruned_pairs", "predictor_cols", "exclude_cols"],
          "properties": {
            "tiers": { "type": "object" },
            "pruned_pairs": { "type": "array" },
            "predictor_cols": { "type": "array", "items": { "type": "string" } },
            "exclude_cols": { "type": "array", "items": { "type": "string" } },
            "derived_features": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["missing"],
          "properties": {
            "missing": { "type": "string" }
          }
        }
      ]
    }
  }
}
