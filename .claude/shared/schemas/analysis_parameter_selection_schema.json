{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "analysis_parameter_selection_schema.json",
 "title": "Analysis Parameter Selection",
 "description": "Phase 0.4 ontology-guided analysis selection — machine-readable tier assignments, predictor/exclude lists for script consumption.",
 "type": "object",
 "required": [
  "source",
  "ontology_file",
  "parameter_physical_groups",
  "quality_targets",
  "analysis_tiers",
  "pruned",
  "predictor_cols",
  "exclude_cols"
 ],
 "properties": {
  "source": {
   "type": "string",
   "description": "Phase origin marker",
   "const": "Phase 0.4 ontology-guided analysis selection"
  },
  "ontology_file": {
   "type": "string",
   "description": "Path to the ontology file used for selection",
   "pattern": "^01_ontology/ontology\\.json$"
  },
  "parameter_physical_groups": {
   "type": "object",
   "description": "Parameters grouped by process stage, physical domain, or causal chain",
   "minProperties": 1,
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "minItems": 0
   }
  },
  "quality_targets": {
   "type": "array",
   "description": "Columns representing quality/inspection outputs, identified from ontology",
   "items": {
    "type": "string"
   },
   "minItems": 0
  },
  "analysis_tiers": {
   "type": "object",
   "required": [
    "tier_1"
   ],
   "properties": {
    "tier_1": {
     "type": "array",
     "description": "Same-stage parameters with known causal physics — analyze first",
     "items": {
      "type": "object",
      "required": [
       "target",
       "predictor",
       "justification"
      ],
      "properties": {
       "target": {
        "type": "string"
       },
       "predictor": {
        "type": "string"
       },
       "justification": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "tier_2": {
     "type": "array",
     "description": "Upstream parameters with plausible propagation paths",
     "items": {
      "type": "object",
      "required": [
       "target",
       "predictor",
       "justification"
      ],
      "properties": {
       "target": {
        "type": "string"
       },
       "predictor": {
        "type": "string"
       },
       "justification": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "tier_3": {
     "type": "array",
     "description": "Parameters with indirect or uncertain physical connections",
     "items": {
      "type": "object",
      "required": [
       "target",
       "predictor",
       "justification"
      ],
      "properties": {
       "target": {
        "type": "string"
       },
       "predictor": {
        "type": "string"
       },
       "justification": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "pruned": {
   "type": "array",
   "description": "Parameter pairs excluded from analysis with physical justification",
   "items": {
    "type": "object",
    "required": [
     "predictor",
     "reason"
    ],
    "properties": {
     "predictor": {
      "type": "string"
     },
     "target": {
      "type": [
       "string",
       "null"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "predictor_cols": {
   "type": "array",
   "description": "Parameter columns to include in statistical analysis (Tier 1+2 predictors)",
   "items": {
    "type": "string"
   }
  },
  "exclude_cols": {
   "type": "array",
   "description": "Columns to exclude from all statistical analysis (metadata, IDs, redundant sensors)",
   "items": {
    "type": "string"
   }
  },
  "derived_features_to_compute": {
   "type": "array",
   "description": "Scenario-specific derived features to compute based on ontology roles",
   "items": {
    "type": "string"
   }
  }
 }
}
