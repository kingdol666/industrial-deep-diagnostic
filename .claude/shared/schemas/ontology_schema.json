{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ontology_schema.json",
  "title": "Process Ontology Schema (domain-agnostic)",
  "description": "Validates an industrial/process ontology. Domain-agnostic: enforces only the structural invariants the diagnostic pipeline needs, never any industry-specific content. Accepts TWO equivalent top-level shapes (canonical bucketed form OR flat parameter form) via anyOf — both are first-class.",
  "type": "object",
  "required": ["ontology_version"],
  "properties": {
    "ontology_version": {
      "type": "string",
      "description": "Version label of the ontology representation (free-form)."
    },
    "process_type": { "type": "string", "description": "Free-text process category (e.g. a process family). Never validated against a fixed enum — the system adapts to any process." },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "scene": {
      "type": "object",
      "description": "Canonical form: process scene block.",
      "properties": {
        "name": { "type": "string" },
        "process_type": { "type": "string" },
        "equipment": { "type": "array", "items": { "type": "object" } },
        "stages": { "type": "array", "items": { "type": "object" } },
        "objectives": { "type": "array", "items": { "type": ["string", "object"] } }
      }
    },
    "signals": {
      "type": "object",
      "description": "Canonical form: variable classification. All buckets are optional; at least one signal must be declared somewhere (enforced by the pipeline, not hard-required here to allow process-only / inspection-only / unknown modes).",
      "properties": {
        "inspection_signals": { "type": "array", "items": { "$ref": "#/definitions/signal_v6" } },
        "process_parameters": { "type": "array", "items": { "$ref": "#/definitions/signal_v6" } },
        "control_variables": { "type": "array", "items": { "$ref": "#/definitions/control_signal" } },
        "events": { "type": "array", "items": { "type": "object" } },
        "metadata_columns": { "type": "array", "items": { "type": ["string", "object"] } }
      }
    },
    "parameters": {
      "type": "array",
      "description": "Flat form: all variables in one list, each carrying a role.",
      "items": { "$ref": "#/definitions/parameter_flat" }
    },
    "equipment": { "type": "array", "items": { "type": "object" } },
    "quality_target_causal_map": {
      "type": "object",
      "description": "Map from a quality/inspection target name to its candidate driver columns. Keys are target names; values are arrays of column names. Free-form — no fixed keys.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "physical_principles": {
      "type": "array",
      "description": "Governing physical laws relevant to this process. Each entry names the principle and the parameters it relates.",
      "items": {
        "type": "object",
        "required": ["principle"],
        "properties": {
          "principle": { "type": "string" },
          "equation": { "type": "string" },
          "parameters": { "type": "array", "items": { "type": "string" } },
          "direction": { "type": "string" }
        }
      }
    },
    "known_failure_modes": {
      "type": "array",
      "description": "Prior failure modes (optional, accelerates diagnosis but never required).",
      "items": { "type": "object" }
    },
    "relationships": {
      "type": "array",
      "description": "Directed relationships between variables (causal / correlative / physical / control).",
      "items": { "$ref": "#/definitions/relationship" }
    },
    "confounders": { "type": "array", "items": { "type": "object" } },
    "parameter_groups": {
      "type": "object",
      "description": "Optional grouping of parameters by physical function for confounder analysis.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "discrepancy_signals": {
      "type": "array",
      "description": "Data-vs-ontology discrepancies surfaced as PRIMARY diagnostic signals.",
      "items": { "type": "object" }
    },
    "metadata": { "$ref": "#/definitions/metadata" }
  },
  "definitions": {
    "signal_v6": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "column": { "type": "string" },
        "unit": { "type": "string" },
        "physical_meaning": { "type": "string" },
        "normal_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "target": { "type": ["number", "string", "null"] },
        "tolerance": { "type": ["number", "string", "null"] },
        "direction": { "type": "string" },
        "governing_law": { "type": "string" },
        "expected_data_behavior": { "type": "string" },
        "observed_data_behavior": { "type": "string" },
        "behavior_match": { "type": "string", "enum": ["CONSISTENT", "CONTRADICTED", "UNVERIFIED"] },
        "discrepancy_signal": { "type": "string" },
        "time_lag": { "type": ["string", "number", "null"] },
        "lag_detection_method": { "type": "string" },
        "optimal_lag": { "type": ["integer", "null"] },
        "lag_agreement": { "type": "string" },
        "lag_compensated_correlation": { "type": ["number", "object", "null"] }
      },
      "additionalProperties": true
    },
    "control_signal": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "column": { "type": "string" },
        "type": { "type": "string" },
        "setpoint": { "type": ["number", "string", "null"] },
        "controller": { "type": "string" },
        "unit": { "type": "string" },
        "manipulated_variable": { "type": "string" }
      },
      "additionalProperties": true
    },
    "parameter_flat": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "description": "Variable role used by the pipeline. The role vocabulary is the only domain-constrained field, because the analysis flow dispatches on it.",
          "enum": ["process_parameter", "quality_target", "inspection_signal", "control_variable", "grouping", "event", "metadata", "time", "exclude"]
        },
        "column": { "type": "string" },
        "stage_ref": { "type": "string" },
        "physical_meaning": { "type": "string" },
        "unit": { "type": "string" },
        "normal_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "direction": { "type": "string" },
        "governing_law": { "type": "string" }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string", "enum": ["causal", "correlative", "control", "physical", "feedback", "unknown"] },
        "direction": { "type": "string", "enum": ["forward", "bidirectional", "reverse", "unknown"] },
        "strength": { "type": "string", "enum": ["strong", "moderate", "weak", "unknown"] },
        "mechanism": { "type": "string" },
        "governing_equation": { "type": "string" },
        "lag": { "type": ["string", "number", "null"] }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "units": { "type": "object", "additionalProperties": { "type": "string" } },
        "sampling_rate": { "type": "string" },
        "timezone": { "type": "string" },
        "data_sources": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    { "required": ["scene", "signals"] },
    { "required": ["parameters"] },
    { "required": ["process_type", "parameters"] }
  ],
  "additionalProperties": true
}
