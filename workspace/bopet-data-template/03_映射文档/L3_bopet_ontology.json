      {
        "id": "pull",
        "name": "牵引收卷",
        "sequence": 5,
        "key_physics": "胡克弹性；张力-应变"
      },
      {
        "id": "inspect",
        "name": "在线/离线检验",
        "sequence": 6,
        "key_physics": "测量系统与工艺真值分离"
      }
    ],
    "objectives": [
      "定位优品率下降与横向厚度劣化的主导原因",
