{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOE context — platform/user supplied run table descriptor (contracts v1.1)",
  "description": "Authored by the platform (RecipeWorkShop) or hand-written. Adapter: scripts/doe_context_adapter.py -> analysis_context.json",
  "type": "object",
  "required": ["contract_version", "experiment_id", "data_file", "factors", "responses"],
  "properties": {
    "contract_version": { "enum": ["1.0", "1.1"] },
    "experiment_id": { "type": "string", "minLength": 1 },
    "line_id": { "type": ["string", "null"] },
    "product_id": { "type": ["string", "null"] },
    "recipe_id": { "type": ["string", "null"] },
    "objective": { "type": ["string", "null"] },
    "design_type_declared": { "type": ["string", "null"] },
    "data_stage": { "enum": ["design_only", "collected"] },
    "design_region": {
      "type": ["object", "null"],
      "properties": {
        "factorial_bounds": { "type": "object" },
        "axial_alpha": { "type": ["number", "null"] },
        "design_hull": { "type": ["string", "null"] }
      }
    },
    "data_file": { "type": "string", "description": "run_table filename relative to 00_input/" },
    "factors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "col"],
        "properties": {
          "name": { "type": "string" },
          "col": { "type": "string" },
          "type": { "enum": ["numeric", "categorical"] },
          "unit": { "type": ["string", "null"] },
          "min": { "type": ["number", "null"] },
          "max": { "type": ["number", "null"] },
          "levels": { "type": ["array", "null"] },
          "role": { "type": ["string", "null"] },
          "expected_sign": { "type": ["string", "null"] },
          "physical_meaning": { "type": ["string", "null"] },
          "ontology_signal": { "type": ["string", "null"] },
          "platform_ref": {
            "type": ["object", "null"],
            "properties": {
              "recipe_param": { "type": ["string", "null"] },
              "node_id": { "type": ["string", "null"] },
              "plc_tag": { "type": ["string", "null"] },
              "unit_conversion": { "type": ["number", "null"] },
              "rounding": { "type": ["number", "null"] },
              "hard_limits": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "col"],
        "properties": {
          "name": { "type": "string" },
          "col": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "goal": { "enum": ["maximize", "minimize", "target", null] },
          "lsl": { "type": ["number", "null"] },
          "usl": { "type": ["number", "null"] },
          "target": { "type": ["number", "null"] },
          "weight": { "type": ["number", "null"] },
          "ontology_signal": { "type": ["string", "null"] },
          "platform_metric_ref": { "type": ["object", "null"] }
        }
      }
    },
    "blocks": { "type": "array", "items": { "type": "string" } },
    "covariates": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factor"],
        "properties": {
          "factor": { "type": "string" },
          "type": { "enum": ["box", "linear", "safety"] },
          "min": { "type": ["number", "null"] },
          "max": { "type": ["number", "null"] },
          "coeff": { "type": ["object", "null"] },
          "hard": { "type": "boolean" },
          "reason": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "replicates_col": { "type": ["string", "null"] },
    "run_order_col": { "type": ["string", "null"] },
    "group_col": { "type": ["string", "null"] },
    "time_col": { "type": ["string", "null"] },
    "current_setpoint": { "type": ["object", "null"] },
    "baseline_source": { "enum": ["platform_recipe", "dataset_median", null] },
    "ontology": {
      "type": ["object", "null"],
      "properties": {
        "profile": { "enum": ["doe", "diagnosis"] },
        "mode": { "enum": ["off", "auto", "full"] },
        "scene_key": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "data_stage": { "enum": ["design_only", "collected", null] }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "properties": {
        "platform": { "type": ["string", "null"] },
        "created_by": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] }
      }
    }
  }
}
